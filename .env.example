DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Servidor API local (opcional)
PORT=3001
# HOST=127.0.0.1  — só este PC | omita ou use 0.0.0.0 para acessar na rede (Wi‑Fi/LAN)
SESSION_SECRET=altere-para-uma-string-longa-e-aleatoria

# Deploy: Vercel (front) + Railway (API) — defina a URL exata do site no Vercel (com https).
# Várias origens: FRONTEND_URL=https://app.vercel.app ou CORS_ORIGINS=https://a.vercel.app,https://b.vercel.app
# Com isso, CORS e cookies de sessão (SameSite=None; Secure) funcionam entre domínios.
# FRONTEND_URL=https://seu-app.vercel.app
# Railway: não defina PORT (a plataforma injeta). HOST=0.0.0.0 se precisar escutar em todas as interfaces.
# TRUST_PROXY=false — só se precisar desativar trust proxy (padrão: ativo)
# Administradores: coluna `role` = ADMIN na tabela User (via Prisma Studio ou PATCH /api/admin/users/:id/role).

# Build de produção: se o front estiver em outro host que o da API, defina a URL base.
# Em `npm run dev`, o Vite ignora VITE_API_URL e usa o proxy (evita porta errada).
# VITE_API_URL=https://sua-api.exemplo.com
