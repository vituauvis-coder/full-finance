{
  "name": "meu-malote",
  "version": "1.0.0",
  "type": "module",
  "description": "Meu Malote — controle financeiro pessoal: rendas, despesas, carteira, cofrinhos, dívidas e planejamento em um só lugar.",
  "main": "server/index.js",
  "scripts": {
    "start": "node scripts/run-with-pg-tools.mjs server/index.js",
    "server": "node scripts/run-with-pg-tools.mjs server/index.js",
    "dev": "node scripts/dev.mjs",
    "dev:app": "concurrently -k \"npm run server\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "restore:account": "node scripts/restore-account-sqlserver-to-supabase.mjs",
    "restore:account:sqlcmd": "node scripts/sqlcmd-upsert-account.mjs",
    "restore:movements:sqlcmd": "node scripts/sqlcmd-restore-account-movements.mjs",
    "export:sqlserver": "node scripts/export-sqlserver-to-json.mjs",
    "import:json": "node scripts/import-json-to-db.mjs",
    "seed:expenses": "node scripts/seed-expenses.mjs",
    "debug:month-expenses": "node scripts/debug-monthly-expenses.mjs",
    "backfill:ledger": "node scripts/backfill-balance-ledger.mjs",
    "db:zero-budget:category": "node scripts/pg-migrate-zero-budget-category.mjs",
    "db:investment-allocation": "node scripts/pg-migrate-investment-allocation.mjs",
    "db:investment-expense-link": "node scripts/pg-migrate-investment-expense-link.mjs",
    "db:cofrinhos-rename": "node scripts/pg-migrate-cofrinhos-rename.mjs"
  },
  "keywords": [],
  "author": "Victor Alves",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mssql": "^12.3.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.16.3",
    "vite": "^7.1.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
