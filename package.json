{
  "name": "meu-mundo",
  "version": "1.0.0",
  "type": "module",
  "description": "Meu Mundo — dinheiro, viagens e ferramentas pessoais em um só lugar.",
  "main": "server/index.js",
  "scripts": {
    "start": "MEU_MUNDO_FRONT=react node platform/scripts/ensure-front-dist.mjs && node platform/scripts/run-with-pg-tools.mjs back/index.js",
    "server": "node platform/scripts/run-with-pg-tools.mjs server/index.js",
    "dev:back": "node platform/scripts/run-with-pg-tools.mjs back/index.js",
    "dev:legacy": "vite",
    "dev:front": "vite --config front/vite.config.ts",
    "dev:front:reset": "rm -rf node_modules/.vite node_modules/.vite-front node_modules/.vite-legacy && vite --config front/vite.config.ts --force",
    "dev": "node platform/scripts/dev.mjs",
    "dev:app": "concurrently -k \"npm run dev:back\" \"npm run dev:front\"",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build --config front/vite.config.ts",
    "build:legacy": "vite build",
    "build:front": "NODE_OPTIONS=--max-old-space-size=4096 vite build --config front/vite.config.ts",
    "build:prod": "npm run build:front",
    "preview": "vite preview",
    "db:backup": "node platform/scripts/run-with-pg-tools.mjs platform/scripts/db-backup-cli.mjs",
    "test": "node --test platform/tests/wallet-plastic.test.js platform/tests/motor/viagens/stay-logistics.test.js platform/tests/motor/viagens/place-display.test.js platform/tests/motor/viagens/trip-countries.test.js platform/tests/motor/viagens/flight-itinerary-items.test.js platform/tests/motor/viagens/country-schedule.test.js platform/tests/motor/viagens/hops-chronology.test.js platform/tests/motor/viagens/atlas-home-stats.test.js platform/tests/motor/viagens/trips-engine.test.js platform/tests/motor/viagens/calendar-format-daykey.test.js platform/tests/motor/viagens/ground-route-policy.test.js platform/tests/motor/viagens/miles-wallet.test.js platform/tests/motor/viagens/flight-ledger.test.js platform/tests/motor/milhas/convert.test.js platform/tests/motor/milhas/catalog.test.js platform/tests/motor/milhas/purchase.test.js platform/tests/motor/milhas/ledger.test.js platform/tests/motor/milhas/emission.test.js platform/tests/motor/milhas/club.test.js platform/tests/motor/viagens/solar.test.js platform/tests/motor/dinheiro/split-net.test.js platform/tests/motor/dinheiro/expense-summary-amount.test.js platform/tests/motor/dinheiro/dashboard-facets.test.js platform/tests/motor/dinheiro/cash-heatmap.test.js platform/tests/motor/dinheiro/calendar-month.test.js platform/tests/motor/dinheiro/chart-month-balance.test.js platform/tests/motor/dinheiro/expected-split-gain-rows.test.js platform/tests/motor/dinheiro/expense-list-period.test.js platform/tests/motor/dinheiro/expense-treemap.test.js platform/tests/motor/conta/profile-rules.test.js",
    "db:miles": "node -e \"import('fs').then(fs=>import('pg').then(({default:pg})=>{const c=new pg.Client({connectionString:process.env.DATABASE_URL});c.connect().then(()=>c.query(fs.readFileSync('platform/prisma/migrations/20261117010000_miles/migration_pg.sql','utf8'))).then(()=>{console.log('miles migration ok');return c.end()}).catch(e=>{console.error(e);process.exit(1)});}))\"",
    "db:trips": "node -e \"import('fs').then(fs=>import('pg').then(({default:pg})=>{const c=new pg.Client({connectionString:process.env.DATABASE_URL});c.connect().then(()=>c.query(fs.readFileSync('platform/prisma/migrations/20261116140000_trips/migration_pg.sql','utf8'))).then(()=>{console.log('trips migration ok');return c.end()}).catch(e=>{console.error(e);process.exit(1)});}))\"",
    "db:expense-trip-link": "node -e \"import('./back/migrations/expense-trip-link.js').then(m=>m.ensureExpenseTripLinkColumns()).then(()=>console.log('expense trip link ok')).catch(e=>{console.error(e);process.exit(1)})\"",
    "restore:account": "node platform/scripts/restore-account-sqlserver-to-supabase.mjs",
    "restore:account:sqlcmd": "node platform/scripts/sqlcmd-upsert-account.mjs",
    "restore:movements:sqlcmd": "node platform/scripts/sqlcmd-restore-account-movements.mjs",
    "export:sqlserver": "node platform/scripts/export-sqlserver-to-json.mjs",
    "import:json": "node platform/scripts/import-json-to-db.mjs",
    "seed:expenses": "node platform/scripts/seed-expenses.mjs",
    "debug:month-expenses": "node platform/scripts/debug-monthly-expenses.mjs",
    "backfill:ledger": "node platform/scripts/backfill-balance-ledger.mjs",
    "db:zero-budget:category": "node platform/scripts/pg-migrate-zero-budget-category.mjs",
    "db:investment-allocation": "node platform/scripts/pg-migrate-investment-allocation.mjs",
    "db:investment-expense-link": "node platform/scripts/pg-migrate-investment-expense-link.mjs",
    "db:cofrinhos-rename": "node platform/scripts/pg-migrate-cofrinhos-rename.mjs"
  },
  "keywords": [],
  "author": "Victor Alves",
  "license": "ISC",
  "dependencies": {
    "@leenguyen/react-flip-clock-countdown": "^1.7.2",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.4",
    "chartjs-chart-treemap": "^3.1.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "maplibre-gl": "^6.18.0",
    "mssql": "^12.3.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^7.1.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2"
  }
}
